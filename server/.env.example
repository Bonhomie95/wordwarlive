# ─── Server ──────────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST (the server refuses to boot in production without):
#   NODE_ENV=production  TRUST_PROXY=1 (behind Render / one load balancer)
#   CORS_ORIGINS=<admin dashboard origin>   METRICS_TOKEN=<random>
#   IAP_ENFORCE=true  GOOGLE_PLAY_PACKAGE_NAME + GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
#   APPLE_BUNDLE_ID + APPLE_TEAM_ID + APPLE_KEY_ID + APPLE_PRIVATE_KEY
#   GOOGLE_CLIENT_IDS (web, iOS, Android)   JWT_SECRET (>= 32 chars)
#   MONGODB_URL (dedicated production database)   REDIS_URL (dedicated instance)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS. In production, lock this
# down to your real client origins. "*" works for local Expo dev.
CORS_ORIGINS=*
# Number of proxy hops to trust for the real client IP (used by rate limiting).
# 0 = server is directly exposed. Set to 1 behind a single load balancer /
# reverse proxy. Do NOT set higher than your actual proxy depth — it lets
# clients spoof X-Forwarded-For and bypass rate limits.
TRUST_PROXY=0
# Stable identity for this instance, used to namespace the per-node matchmaking
# queue and to label logs/metrics when running more than one node. Leave empty
# for single-node/dev (defaults to hostname). In production set it to the
# pod/task/instance name so a restart reuses its queue namespace.
NODE_ID=

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Atlas connection string including the database name. Collections, indexes
# and seed content are created at boot (src/db/seed.ts). Use a separate
# database name per environment (e.g. /wordwar_prod).
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/wordwar

# MongoDB connection pool size.
DB_POOL_MAX=50

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-long-random-string
# 30 days
JWT_EXPIRES_IN=30d

# Google Sign-In — get from Google Cloud Console (OAuth 2.0 Client IDs).
# You'll typically have one ID per platform; the server validates whichever
# id_token the client sends, so list every client ID that should be accepted.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Apple Sign-In — your app's bundle ID is the audience the server checks.
APPLE_BUNDLE_ID=dev.bonhomieinc.wordwar
# Sign in with Apple key (Apple Developer → Certificates, IDs & Profiles → Keys →
# "Sign in with Apple"). REQUIRED for App Store compliance: Apple mandates that
# the user's Sign in with Apple tokens are revoked when they delete their
# account. Paste the .p8 contents as one line with \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Shown on the hosted legal pages (/legal/*) and the account-deletion page.
SUPPORT_EMAIL=adeyemibabatundejoseph@gmail.com

# ─── Error reporting ─────────────────────────────────────────────────────────
# Optional. When set, exceptions are forwarded to Sentry (requires
# `npm i @sentry/node`). Leave empty to just log errors.
SENTRY_DSN=

# ─── Metrics ─────────────────────────────────────────────────────────────────
# Optional bearer token protecting GET /metrics (active matches, queue depth,
# online users, pool stats). Leave empty to expose it openly on an internal
# network; set a token if /metrics is reachable publicly.
METRICS_TOKEN=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Comma-separated emails auto-promoted to admin at boot and on their next email
# login. This bootstraps the first admin for the /admin/* API + the admin/ app.
# The account must sign up with email auth (it needs a password to log in).
# You can also promote from the CLI: npm run make-admin -- you@wordwar.app
ADMIN_EMAILS=you@example.com

# ─── Groq ────────────────────────────────────────────────────────────────────
# Used for the bot opponent and daily-word curation.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Game tuning ─────────────────────────────────────────────────────────────
MATCH_DURATION_SECONDS=360
MATCHMAKING_BOT_AFTER_SECONDS=20
MATCHMAKING_RANGE_START=200
MATCHMAKING_RANGE_EXPANDED=500
GUESS_RATE_LIMIT_MS=2000

# ─── In-app purchases ────────────────────────────────────────────────────────
# When true, purchase endpoints verify the store receipt (and enforce one grant
# per transaction) before handing out coins / cosmetics / battle pass / remove-
# ads. Leave false for local dev so the shop stays interactive without real
# receipts. Defaults to TRUE when NODE_ENV=production.
IAP_ENFORCE=false
# iOS purchases are verified OFFLINE from the StoreKit 2 signed transaction
# (JWS) using Apple's pinned root certificate — no key needed. The shared
# secret below is only used as a fallback for legacy base64 receipts
# (App Store Connect → App Information → App-Specific Shared Secret).
APPLE_IAP_SHARED_SECRET=
# Google Play verification (required for Android when IAP_ENFORCE=true).
# The app's package name, plus a Google Cloud service-account key JSON with the
# Android Publisher (androidpublisher) scope, pasted as a single line.
GOOGLE_PLAY_PACKAGE_NAME=dev.bonhomieinc.wordwar
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ─── AdMob ───────────────────────────────────────────────────────────────────
# The SSV (Server-Side Verification) URL is configured in the AdMob dashboard
# under each rewarded ad unit's Server-side verification settings.
# It must be: https://<your API host>/api/ads/ssv
# AdMob's signing keys are fetched automatically from gstatic.com — no key
# config is needed on this side.
